{
  "name": "anikeen/console",
  "description": "PHP Anikeen Console API client for Laravel 12+",
  "license": "MIT",
  "authors": [
    {
      "name": "René Preuß",
      "email": "rene@anikeen.com"
    },
    {
      "name": "Maurice Preuß",
      "email": "maurice@anikeen.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "anikeen/id": "^3.6",
    "illuminate/cache": "^12.69|^13.0",
    "illuminate/http": "^12.69|^13.0",
    "illuminate/routing": "^12.69|^13.0",
    "illuminate/support": "^12.69|^13.0",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "laravel/framework": "^12.69|^13.0",
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Anikeen\\Console\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Anikeen\\Console\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Anikeen\\Console\\Providers\\AnikeenConsoleServiceProvider"
      ],
      "aliases": {
        "AnikeenConsole": "Anikeen\\Console\\Facades\\AnikeenConsole"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
